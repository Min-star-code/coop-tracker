# Copy to .env and fill in. Never commit .env.
# Production PostgreSQL. Leave empty locally to use PGlite in ./.pglite
DATABASE_URL=
# Google AI Studio key for the job classifier. Empty = /api/classify returns 503.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash)
GEMINI_MODEL=
# For npm run sync
SYNC_URL=http://localhost:3000
SYNC_TOKEN=
